# Copy this file to .env and fill in your own key.
# The real .env is git-ignored and must never be committed.

# Portkey gateway key, used by all five agents via the OpenAI-compatible API.
PORTKEY_API_KEY=your_key_here

# Optional — defaults to https://api.portkey.ai/v1 if unset.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
